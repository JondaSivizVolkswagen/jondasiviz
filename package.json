{
  "name": "jondasiviz",
  "private": true,
  "version": "0.1.0",
  "description": "Planificador de presupuestos de preparacion para modelos Volkswagen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "plan": "tsx src/cli/plan.ts",
    "probar": "tsx src/cli/probar.ts",
    "vault:export": "tsx src/ingest/run.ts export",
    "vault:ingest": "tsx src/ingest/run.ts ingest",
    "tauri": "tauri",
    "escritorio:dev": "tauri dev",
    "escritorio:build": "tauri build",
    "api": "tsx src/api/run.ts",
    "db:sembrar": "tsx src/db/run.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.0",
    "gray-matter": "^4.0.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
