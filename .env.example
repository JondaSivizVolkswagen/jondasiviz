# Copia este fichero a `.env` y rellena lo que necesites. `.env` no se sube nunca.
#
# Sin nada de esto el proyecto funciona igual: base en un fichero local y pago
# simulado. Hace falta solo cuando se quiere la base en la nube o cobrar de verdad.

# Base de datos en Turso. Sin ellas se usa datos/jondasiviz.db, que es un fichero.
# La URL y el token salen del panel de turso.tech al crear la base.
JONDA_DB_URL=
JONDA_DB_TOKEN=

# Secreto del webhook de GitHub, el mismo que se ponga en Ajustes del repositorio.
# Sin esto, /api/webhook/github rechaza cualquier entrega.
JONDA_WEBHOOK_SECRET=

# Stripe. Vacías = pasarela simulada, que marca la suscripción sin cobrar nada.
# Con la clave puesta se cobra de verdad y la pasarela simulada deja de existir.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECIO_ID=

# A dónde vuelve el navegador después de pagar.
JONDA_URL=http://localhost:5173
